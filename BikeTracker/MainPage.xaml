<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BikeTracker.MainPage"
             Title="BLE logger">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="14">

            <Label Text="Zariadenie: Calvin_E (UUID 00360010-8888-8888-8888-777777777777)"
                   FontSize="13" />

            <Entry x:Name="DistanceEntry"
                   Placeholder="Vzdialenosť od zariadenia (m)"
                   Keyboard="Numeric"
                   TextChanged="OnLabelChanged" />

            <Entry x:Name="ScenarioEntry"
                   Placeholder="Scenár (napr. LOS, stena, telo, kov)"
                   TextChanged="OnLabelChanged" />

            <Button x:Name="StartStopBtn"
                    Text="Štart záznamu"
                    Clicked="OnStartStopClicked" />

            <Label x:Name="StatusLabel"
                   Text="Pripravené." />

            <Button x:Name="ShareBtn"
                    Text="Zdieľať CSV"
                    IsEnabled="False"
                    Clicked="OnShareClicked" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
