<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BikeTracker.MainPage"
             Title="BLE logger">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">

            <Label Text="Zariadenie: Calvin_E (UUID 00360010-8888-8888-8888-777777777777)"
                   FontSize="13" />

            <Entry x:Name="DistanceEntry"
                   Placeholder="Vzdialenosť od zariadenia (m)"
                   Keyboard="Numeric"
                   Completed="OnLabelChanged"
                   Unfocused="OnLabelChanged" />

            <Label Text="Scenár (vyber všetko, čo platí):" FontSize="13" />

            <FlexLayout Wrap="Wrap" JustifyContent="Start">
                <HorizontalStackLayout Margin="0,0,14,0">
                    <CheckBox x:Name="TagLos" CheckedChanged="OnTagChanged" />
                    <Label Text="LOS" VerticalOptions="Center" />
                </HorizontalStackLayout>
                <HorizontalStackLayout Margin="0,0,14,0">
                    <CheckBox x:Name="TagClovek" CheckedChanged="OnTagChanged" />
                    <Label Text="človek" VerticalOptions="Center" />
                </HorizontalStackLayout>
                <HorizontalStackLayout Margin="0,0,14,0">
                    <CheckBox x:Name="TagStena" CheckedChanged="OnTagChanged" />
                    <Label Text="stena" VerticalOptions="Center" />
                </HorizontalStackLayout>
                <HorizontalStackLayout Margin="0,0,14,0">
                    <CheckBox x:Name="TagKov" CheckedChanged="OnTagChanged" />
                    <Label Text="kov" VerticalOptions="Center" />
                </HorizontalStackLayout>
                <HorizontalStackLayout Margin="0,0,14,0">
                    <CheckBox x:Name="TagStol" CheckedChanged="OnTagChanged" />
                    <Label Text="stôl" VerticalOptions="Center" />
                </HorizontalStackLayout>
                <HorizontalStackLayout Margin="0,0,14,0">
                    <CheckBox x:Name="TagVonku" CheckedChanged="OnTagChanged" />
                    <Label Text="vonku" VerticalOptions="Center" />
                </HorizontalStackLayout>
            </FlexLayout>

            <Button x:Name="StartStopBtn"
                    Text="Štart záznamu"
                    Clicked="OnStartStopClicked" />

            <Button x:Name="PauseBtn"
                    Text="Pauza (presúvam zariadenie)"
                    IsEnabled="False"
                    Clicked="OnPauseClicked" />

            <Label x:Name="StatusLabel"
                   Text="Pripravené." />

            <Button x:Name="ShareBtn"
                    Text="Zdieľať CSV"
                    IsEnabled="False"
                    Clicked="OnShareClicked" />

            <Button Text="Živý režim (black box)" Clicked="OnOpenLiveClicked" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>